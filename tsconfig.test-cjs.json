{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "test",
    "outDir": "test-build",
    "declaration": false
  },
  "include": [
    "test/harness-core.ts",
    "test/harness.ts",
    "test/cases.ts",
    "test/capture.ts",
    "test/cjs/**/*.ts"
  ]
}
